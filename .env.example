# Admin dashboard token (/embassy-admin). At least 24 characters; admin is disabled if unset.
# Generate one with: openssl rand -base64 32
ADMIN_TOKEN=

# Postgres connection string (e.g. Neon). If unset, submissions are kept in memory only.
DATABASE_URL=

# Email notifications for new quote requests and contact messages.
# Where notifications are sent (defaults to landembassyltd@gmail.com)
ADMIN_EMAIL=landembassyltd@gmail.com
# SMTP account that sends them. For Gmail: the Gmail address and an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
# Notifications are disabled if SMTP_USER or SMTP_PASS is unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=landembassyltd@gmail.com
SMTP_PASS=
# Optional sender address (defaults to SMTP_USER)
MAIL_FROM=

# Property image uploads in the admin dashboard (Vercel Blob). Set automatically
# when a Blob store is connected to the Vercel project. Without it, images can
# still be added by link.
BLOB_READ_WRITE_TOKEN=
